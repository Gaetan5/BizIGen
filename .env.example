# ============================================
# BizGen AI - Environment Template (.env.example)
# Copiez ce fichier en '.env' et renseignez vos clés
# ============================================

# Application
NODE_ENV=development
DEBUG=true
SECRET_KEY=generate_a_secure_random_32_char_hex_string
INTERNAL_API_KEY=generate_a_secure_32_char_hex_string

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_secure_random_string

# Backend URL for Frontend integration
PYTHON_BACKEND_URL=http://localhost:3001

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Database (PostgreSQL)
POSTGRES_USER=bizgen
POSTGRES_PASSWORD=generate_a_secure_password_without_special_chars
POSTGRES_DB=bizgen
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5435/${POSTGRES_DB}

# Database (SQLite fallback - pour dev local autonome)
# DATABASE_URL="file:./dev.db"

# Redis
REDIS_URL=redis://localhost:6380/0

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Payment (Flutterwave - Afrique)
FLUTTERWAVE_SECRET_KEY=FLWSECK_...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_...
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_secret_hash

# Monitoring
SENTRY_DSN=
GRAFANA_USER=admin
GRAFANA_PASSWORD=generate_a_secure_grafana_password

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@bizgen-ai.com

# n8n Cognitive Hub Integration (optionnel - Active l'enrichissement marché intelligent)
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/bizgen-events
N8N_WEBHOOK_SECRET=generate_a_secure_64_char_hex_string
